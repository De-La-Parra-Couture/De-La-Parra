# =============================================================================
# De la Parra Couture — Variables de entorno
# =============================================================================
# Este archivo documenta las variables necesarias para el despliegue en Vercel
# (dashboard de Keystatic con login de GitHub). Copia este archivo a .env solo
# si quieres probar el modo GitHub en local; Vercel se configura desde su panel.
#
# El repositorio de contenido está fijo en keystatic.config.ts:
#   owner: De-La-Parra-Couture
#   name:  De-La-Parra

# ── Keystatic (modo GitHub) ──────────────────────────────────────────────────
# Creadas al configurar una GitHub App (Settings → Developer settings → Apps)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Clave de sesión para cifrar las cookies del panel (generar con openssl rand -hex 32)
KEYSTATIC_SECRET=

# Slug de la GitHub App (aparece en su URL pública: github.com/apps/<slug>)
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
